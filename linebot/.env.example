# 複製成 .env.local 給本機測試用（npx vercel dev）；正式環境請在 Vercel 專案 Settings → Environment Variables 設定

# 管理系統（網站「BOT 設定」頁的「連線資訊」可以複製）
GAS_URL=
# 客服與員工助理用「兩把不同的金鑰」（BOT 設定 → 連線與設定 分別產生）。
# 建議各部署一個 Vercel 專案：客服專案只放 BOT_CS_SECRET + 客服 LINE；員工專案只放 BOT_STAFF_SECRET + 員工 LINE。
BOT_CS_SECRET=
BOT_STAFF_SECRET=
# 舊版共用金鑰（只有還沒拆開時才用；兩把金鑰都設定後可以刪掉）
BOT_SECRET=

# ===== 對外客服機器人的 LINE 官方帳號（LINE Developers Console → 你的 Channel；Webhook 填 /api/cs）=====
CS_LINE_CHANNEL_SECRET=
CS_LINE_CHANNEL_ACCESS_TOKEN=

# ===== 員工助理的 LINE 官方帳號（選填；Webhook 填 /api/line）=====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== 選填 =====
# 時區（預設 Asia/Taipei）
BOT_TIMEZONE=
# 網站網址：機器人請使用者「到網站操作」時附上（例如 https://omg8787.github.io/aoi_sales/）
SITE_URL=
# 機器人自己的網址；沒填就用 Vercel 正式網址
BOT_URL=
